//Paso 3: checksum .BLUDIT_BACKUP
Guarda esto como fix_checksum.py (en el mismo directorio que el zip):
1. Usa el script Python:


import zipfile
import hashlib

tmp = "NOMBRE_DEL_ZIP.zip"

# Elimina cualquier .BLUDIT_BACKUP existente
with zipfile.ZipFile(tmp, 'r') as zin:
    names = zin.namelist()
    data = {name: zin.read(name) for name in names if name != '.BLUDIT_BACKUP'}

with zipfile.ZipFile(tmp, 'w') as zout:
    for name, content in data.items():
        zout.writestr(name, content)

# Calcula el MD5 del zip sin el checksum
checksum = hashlib.md5(open(tmp, 'rb').read()).hexdigest()

# Agrega el .BLUDIT_BACKUP con el checksum correcto
with zipfile.ZipFile(tmp, 'a') as zapp:
    zapp.writestr('.BLUDIT_BACKUP', checksum)

print(f"Checksum: {checksum}")

2. Ejecutamos
python3 fix_checksum.py

